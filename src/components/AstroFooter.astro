---
import { footerLinkSections, legalNavLinks } from '../../shared/siteNavigation';
import { localizePath } from '../../shared/langRouting';

export interface Props { lang?: 'zh' | 'en'; }
const { lang = 'zh' } = Astro.props;
const text = <T,>(value: { zh: T; en: T }) => (lang === 'zh' ? value.zh : value.en);
const year = new Date().getFullYear();
const frontmindLogo = '/brand/frontmind-logo.svg';
---

<footer class="border-t border-[#3D1560]/8 bg-[#FBFAFC] py-14">
  <div class="container">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <a href={localizePath('/', lang)} class="mb-5 flex h-11 items-center no-underline" aria-label="FrontMind Home">
          <img src={frontmindLogo} alt="FrontMind" class="h-9 w-auto max-w-[170px] object-contain" />
        </a>
        <p class="max-w-sm text-sm leading-relaxed text-[#6B7280]" style="font-family: 'DM Sans', sans-serif;">
          {lang === 'zh'
            ? 'FrontMind 为高信任企业构建战略判断、品牌语义与智能体增长系统。'
            : 'FrontMind builds strategic judgment, brand semantics, and agentic growth systems for high-trust enterprises.'}
        </p>
      </div>
      <div class="grid grid-cols-1 gap-8 sm:grid-cols-3 lg:col-span-7">
        {footerLinkSections.map((section) => (
          <div>
            <h3 class="mb-4 text-xs font-bold uppercase tracking-[0.22em] text-[#C5A24D]" style="font-family: 'DM Sans', sans-serif;">{text(section.title)}</h3>
            <div class="space-y-3">
              {section.links.map((link) => (
                <a href={localizePath(link.href, lang)} class="block text-sm text-[#6B7280] no-underline transition-colors hover:text-[#3D1560]" style="font-family: 'DM Sans', sans-serif;">{text(link.label)}</a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
    <div class="mt-12 flex flex-col gap-4 border-t border-[#3D1560]/8 pt-6 text-xs text-[#9CA3AF] sm:flex-row sm:items-center sm:justify-between" style="font-family: 'DM Sans', sans-serif;">
      <div>© {year} FrontMind. All rights reserved.</div>
      <div class="flex flex-wrap gap-4">
        {legalNavLinks.map((link) => <a href={localizePath(link.href, lang)} class="text-[#9CA3AF] no-underline hover:text-[#3D1560]">{text(link.label)}</a>)}
      </div>
    </div>
  </div>
</footer>
