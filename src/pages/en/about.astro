---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AstroSectionLabel from '../../components/AstroSectionLabel.astro';

const values = [
  { title: 'Research-led', desc: 'We ground brand intelligence in academic discipline, model understanding, and structured judgment.' },
  { title: 'Brand-minded', desc: 'We respect the reputation, expertise, and trust assets enterprises have built over time.' },
  { title: 'Engineering depth', desc: 'We connect natural language processing, multi-agent systems, and enterprise-grade product thinking.' },
  { title: 'Long-term orientation', desc: 'We focus on how a brand is continuously understood, trusted, and selected in AI environments.' },
];
const stats = [
  { value: '80%', label: 'Team members with master or doctoral backgrounds' },
  { value: '10+', label: 'Average years of research and industry experience' },
  { value: '30+', label: 'Related papers and research foundations' },
  { value: '5+', label: 'Core technical patent directions' },
];
const foundations = [
  'Born from the innovation ecosystem of The Chinese University of Hong Kong, Shenzhen',
  'Connected to research capability and computing resources from intelligent decision systems',
  'Team backgrounds span CUHK-Shenzhen, Caltech, HKU, Tsinghua, NYU, and related academic ecosystems',
  'Continuous work across NLP, multi-agent systems, reinforcement learning, and brand semantics',
];
const credibilityPillars = [
  { label: 'Research', title: 'Research capability', desc: 'Sustained methodology across natural language processing, multi-agent systems, reinforcement learning, and brand semantics.' },
  { label: 'Recognition', title: 'Innovation recognition', desc: 'Recognized by Hong Kong, China and mainland China innovation and entrepreneurship programs.' },
  { label: 'Product', title: 'Product system', desc: 'MindPromise and MindReach connect brand semantics, trust evidence, and agentic growth.' },
  { label: 'Practice', title: 'Industry understanding', desc: 'For high-trust sectors such as education, technology, healthcare, and finance, research capability becomes an enterprise-ready brand intelligence system.' },
];
---
<BaseLayout title="About FrontMind - Brand Intelligence for the AI Era" description="FrontMind combines brand strategy, semantic intelligence, and AI agents to help premium enterprises be understood, trusted, and selected in the AI era." lang="en" includeChrome={true} currentPath="/en/about">
  <section class="relative overflow-hidden bg-white pt-32 pb-24"><div class="absolute inset-0 opacity-[0.04]" style="background-image: radial-gradient(circle at 20% 10%, #3D1560 0, transparent 28%), radial-gradient(circle at 88% 0%, #C5A24D 0, transparent 22%);"></div><div class="container relative z-10"><div class="max-w-4xl"><AstroSectionLabel text="About FrontMind" color="gold" /><h1 class="mb-7 text-5xl font-bold leading-tight text-[#1A1A2E] md:text-7xl" style="font-family: 'DM Serif Display', serif;">Born from research, built for brands</h1><p class="max-w-3xl text-lg leading-relaxed text-[#6B7280]" style="font-family: 'DM Sans', sans-serif;">FrontMind was created within the innovation ecosystem of The Chinese University of Hong Kong, Shenzhen. We believe generative AI is rewriting how brands are discovered, interpreted, and trusted. Enterprises do not simply need more content or more tools. They need an intelligent system that keeps their brand clear, credible, and continuously relevant in the AI era.</p></div></div></section>
  <section class="bg-[#FBFAFC] py-20 md:py-28"><div class="container"><div class="grid grid-cols-1 gap-px bg-[#e5e7eb] md:grid-cols-2"><div class="bg-white p-8 md:p-10"><div class="mb-5 h-px w-12 bg-[#C5A24D]"></div><h2 class="mb-4 text-3xl font-bold text-[#1A1A2E]" style="font-family: 'DM Serif Display', serif;">Our mission</h2><p class="text-sm leading-relaxed text-[#6B7280]" style="font-family: 'DM Sans', sans-serif;">To make the true value of enterprises accurately expressible in the AI era. FrontMind transforms positioning, expertise, content assets, and proof into semantic structures that intelligent systems can understand.</p></div><div class="bg-white p-8 md:p-10"><div class="mb-5 h-px w-12 bg-[#C5A24D]"></div><h2 class="mb-4 text-3xl font-bold text-[#1A1A2E]" style="font-family: 'DM Serif Display', serif;">Our vision</h2><p class="text-sm leading-relaxed text-[#6B7280]" style="font-family: 'DM Sans', sans-serif;">To become the trusted brand intelligence partner for the AI era, helping premium enterprises build durable advantages across generative engines, AI agents, and future commercial interfaces.</p></div></div></div></section>
  <section class="bg-white py-20 md:py-28"><div class="container"><div class="mb-14 max-w-3xl"><AstroSectionLabel text="Our Belief" color="purple" /><h2 class="mb-5 text-4xl font-bold leading-tight text-[#1A1A2E] md:text-6xl" style="font-family: 'DM Serif Display', serif;">The next brand advantage comes from being correctly understood by AI</h2><p class="text-base leading-relaxed text-[#6B7280]" style="font-family: 'DM Sans', sans-serif;">In the search era, brands competed for visibility. In the AI era, they compete for interpretation. FrontMind focuses not only on whether a brand is mentioned, but on how AI understands its position, cites its proof, explains its value, and maintains consistency over time.</p></div><div class="grid grid-cols-1 gap-6 md:grid-cols-4">{values.map((item) => <article class="fm-card p-7"><h3 class="mb-3 text-2xl font-bold text-[#1A1A2E]" style="font-family: 'DM Serif Display', serif;">{item.title}</h3><p class="text-sm leading-relaxed text-[#6B7280]" style="font-family: 'DM Sans', sans-serif;">{item.desc}</p></article>)}</div></div></section>
  <section class="bg-[#FBFAFC] py-20 md:py-28"><div class="container"><div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-12"><div class="lg:col-span-4"><AstroSectionLabel text="Team" color="gold" /><h2 class="text-4xl font-bold leading-tight text-[#1A1A2E] md:text-6xl" style="font-family: 'DM Serif Display', serif;">An interdisciplinary elite team</h2></div><div class="lg:col-span-8"><div class="space-y-6"><p class="text-base leading-relaxed text-[#4B5563]" style="font-family: 'DM Sans', sans-serif;">FrontMind brings together artificial intelligence, natural language processing, brand strategy, commercial growth, and enterprise product expertise. Our team combines academic depth with practical experience from technology and industry contexts.</p><p class="text-base leading-relaxed text-[#4B5563]" style="font-family: 'DM Sans', sans-serif;">This structure allows FrontMind to understand models, brands, and the decisions leadership teams must make across reputation, growth, and organizational capability.</p><div class="grid grid-cols-2 gap-4 border-t border-[#e8e4ec] pt-6 md:grid-cols-4">{stats.map((stat) => <div class="fm-card-soft p-4"><div class="text-2xl font-bold italic text-[#3D1560]" style="font-family: 'DM Serif Display', serif;">{stat.value}</div><div class="mt-1 text-xs text-[#9CA3AF]" style="font-family: 'DM Sans', sans-serif;">{stat.label}</div></div>)}</div></div></div></div></div></section>
  <section class="bg-white py-20 md:py-28"><div class="container"><div class="grid grid-cols-1 items-start gap-14 lg:grid-cols-2"><div><AstroSectionLabel text="Foundation" color="purple" /><h2 class="mb-5 text-4xl font-bold leading-tight text-[#1A1A2E] md:text-6xl" style="font-family: 'DM Serif Display', serif;">Rooted in research, oriented toward real business</h2><p class="mb-8 text-base leading-relaxed text-[#6B7280]" style="font-family: 'DM Sans', sans-serif;">Our methodology comes from sustained research on AI information structures, brand semantic assets, and agentic intelligence. We care about the boundaries of technology and the long-term expression enterprises need in complex markets.</p><div class="space-y-3">{foundations.map((item) => <div class="fm-card-soft p-4 text-sm font-medium text-[#1A1A2E]" style="font-family: 'DM Sans', sans-serif;">{item}</div>)}</div></div><div class="fm-emphasis-card p-8 md:p-10"><h3 class="mb-6 text-3xl font-bold text-[#1A1A2E]" style="font-family: 'DM Serif Display', serif;">Credibility foundations</h3><div class="space-y-5">{credibilityPillars.map((item) => <div class="border-t border-[#3D1560]/10 pt-5 first:border-t-0 first:pt-0"><div class="mb-2 text-xs font-bold uppercase tracking-[0.18em] text-[#C5A24D]" style="font-family: 'DM Sans', sans-serif;">{item.label}</div><h4 class="mb-2 text-base font-bold text-[#1A1A2E]" style="font-family: 'DM Serif Display', serif;">{item.title}</h4><p class="text-sm leading-relaxed text-[#6B7280]" style="font-family: 'DM Sans', sans-serif;">{item.desc}</p></div>)}</div></div></div></div></section>
  <section class="bg-[#1A1A2E] py-20 text-white md:py-28"><div class="container"><div class="mx-auto max-w-4xl text-center"><AstroSectionLabel text="FrontMind" color="gold" /><h2 class="mb-6 text-4xl font-bold leading-tight md:text-6xl" style="font-family: 'DM Serif Display', serif;">Redefining how brands win in the AI era</h2><p class="mx-auto max-w-2xl text-base leading-relaxed text-white/70" style="font-family: 'DM Sans', sans-serif;">We want every enterprise with real expertise and long-term value to be more accurately understood, more appropriately represented, and more confidently chosen in the AI era.</p></div></div></section>
</BaseLayout>
