---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AstroSectionLabel from '../../components/AstroSectionLabel.astro';

const topics = ['Enterprise AI strategy', 'Brand semantics', 'Agentic growth', 'Organizational capability'];
const emails = ['fanzengxia@link.cuhk.edu.cn', 'litongxin@cuhk.edu.cn'];
const mailSubject = 'FrontMind Business Conversation | Company Name';
const mailBody = [
  'Company name:',
  'Your name and title:',
  'Company website:',
  'Company introduction material:',
  'Topic you would like to discuss:',
  'Current business context:',
  'Preferred next step:',
].join('\n');
const mailtoHref = (email: string) => `mailto:${email}?subject=${encodeURIComponent(mailSubject)}&body=${encodeURIComponent(mailBody)}`;
const briefingItems = ['Company context', 'Your role', 'Conversation goal'];
const sampleLines = [
  'Subject: FrontMind Business Conversation | Company Name',
  '',
  'Hello FrontMind team,',
  '',
  'We are from Company Name. Our website is Company Website. My name is Name, and I lead the relevant function.',
  '',
  'I have attached our company introduction material for your reference.',
  '',
  'We would like to discuss brand visibility in generative answers, agentic growth opportunities, or enterprise AI workflow deployment.',
  '',
  'If the direction is aligned, we would appreciate an initial conversation.',
  '',
  'Thank you.',
].join('\n');
---

<BaseLayout
  title="Contact FrontMind - Strategic Conversation"
  description="Contact FrontMind to discuss GEO, AI brand visibility, agentic growth, enterprise AI workflow deployment, and FDE embedding."
  lang="en"
  includeChrome={true}
  currentPath="/en/contact"
>
  <section class="relative overflow-hidden pt-32 pb-24">
    <div class="absolute inset-0 opacity-[0.05]" style="background-image: radial-gradient(circle at 18% 14%, #3D1560 0, transparent 30%), radial-gradient(circle at 88% 0%, #C5A24D 0, transparent 24%);"></div>
    <div class="container relative z-10">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <AstroSectionLabel text="Contact" color="gold" />
          <h1 class="mb-7 text-5xl font-bold leading-tight text-[#1A1A2E] md:text-7xl" style="font-family: 'DM Serif Display', serif;">Start a business conversation with FrontMind</h1>
          <p class="max-w-2xl text-lg leading-relaxed text-[#6B7280]" style="font-family: 'DM Sans', sans-serif;">If your organization is exploring AI search visibility, agentic growth, or enterprise AI workflows, share your business context and collaboration direction with us.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            {topics.map((item) => <span class="rounded-full border border-[#3D1560]/10 bg-white px-4 py-2 text-xs font-bold uppercase tracking-[0.16em] text-[#3D1560]" style="font-family: 'DM Sans', sans-serif;">{item}</span>)}
          </div>
        </div>
        <div class="lg:col-span-5">
          <div class="fm-emphasis-card p-9 md:p-12">
            <h2 class="mb-5 text-4xl font-bold leading-tight text-[#1A1A2E]" style="font-family: 'DM Serif Display', serif;">Strategic Conversation</h2>
            <p class="mb-8 text-sm leading-relaxed text-[#6B7280]" style="font-family: 'DM Sans', sans-serif;">Your note may briefly include company context, your role, introduction material, and the topic you would like to discuss. The FrontMind team will review the material and suggest an appropriate next step.</p>
            <div class="space-y-3">
              {emails.map((email) => <a href={mailtoHref(email)} class="inline-flex w-full justify-center rounded-md bg-[#3D1560] px-6 py-4 text-sm font-bold text-white no-underline">{email}</a>)}
            </div>
          </div>
        </div>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-8 lg:grid-cols-12">
        <div class="fm-card p-7 lg:col-span-5">
          <h2 class="mb-5 text-3xl font-bold leading-tight text-[#1A1A2E]" style="font-family: 'DM Serif Display', serif;">Suggested Context</h2>
          <ul class="space-y-3">
            {briefingItems.map((item) => <li class="text-sm leading-relaxed text-[#4B5563]" style="font-family: 'DM Sans', sans-serif;">• {item}</li>)}
          </ul>
        </div>
        <div class="fm-emphasis-card p-7 lg:col-span-7">
          <h2 class="mb-5 text-3xl font-bold leading-tight text-[#1A1A2E]" style="font-family: 'DM Serif Display', serif;">Sample Note</h2>
          <pre class="whitespace-pre-wrap border-l-2 border-[#C5A24D] bg-white px-5 py-4 text-sm leading-relaxed text-[#4B5563]" style="font-family: 'DM Sans', sans-serif;">{sampleLines}</pre>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
