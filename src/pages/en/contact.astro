---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AstroSectionLabel from '../../components/AstroSectionLabel.astro';

const topics = ['Enterprise AI strategy', 'Brand semantics', 'Agentic growth', 'Organizational capability'];
---

<BaseLayout
  title="Contact FrontMind - Strategic Conversation"
  description="Begin a high-quality conversation with FrontMind on enterprise AI strategy, brand semantics, and intelligent growth systems."
  lang="en"
  includeChrome={true}
  currentPath="/en/contact"
>
  <section class="relative overflow-hidden pt-32 pb-24">
    <div class="absolute inset-0 opacity-[0.05]" style="background-image: radial-gradient(circle at 18% 14%, #3D1560 0, transparent 30%), radial-gradient(circle at 88% 0%, #C5A24D 0, transparent 24%);"></div>
    <div class="container relative z-10">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <AstroSectionLabel text="Contact" color="gold" />
          <h1 class="mb-7 text-5xl font-bold leading-tight text-[#1A1A2E] md:text-7xl" style="font-family: 'DM Serif Display', serif;">Begin a high-quality AI strategy conversation</h1>
          <p class="max-w-2xl text-lg leading-relaxed text-[#6B7280]" style="font-family: 'DM Sans', sans-serif;">If your organization is rethinking brand understanding, growth order, and capability in the AI era, FrontMind can help define the advantage worth owning.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            {topics.map((item) => <span class="rounded-full border border-[#3D1560]/10 bg-white px-4 py-2 text-xs font-bold uppercase tracking-[0.16em] text-[#3D1560]" style="font-family: 'DM Sans', sans-serif;">{item}</span>)}
          </div>
        </div>
        <div class="lg:col-span-5">
          <div class="fm-emphasis-card p-9 md:p-12">
            <h2 class="mb-5 text-4xl font-bold leading-tight text-[#1A1A2E]" style="font-family: 'DM Serif Display', serif;">Strategic Conversation</h2>
            <p class="mb-8 text-sm leading-relaxed text-[#6B7280]" style="font-family: 'DM Sans', sans-serif;">Share your industry, current AI agenda, and the capability your leadership team intends to build. We will respond from an executive perspective and suggest an appropriate next step.</p>
            <a href="mailto:hello@frontmind.net?subject=FrontMind Strategic Conversation" class="inline-flex w-full justify-center rounded-md bg-[#3D1560] px-6 py-4 text-sm font-bold text-white no-underline">Email us</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
