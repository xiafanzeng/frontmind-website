---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AstroSectionLabel from '../../components/AstroSectionLabel.astro';
const systems = [
  { id: 'mindpromise', name: 'MindPromise', tag: 'Brand Intelligence', title: 'Make the true value of your brand understandable to AI', desc: 'MindPromise organizes positioning, capability boundaries, industry context, content assets, and proof into a brand semantic system that generative engines can recognize, cite, and continuously interpret.', points: ['Brand semantic architecture', 'Authority content assets', 'AI answer consistency', 'Trust evidence structure'] },
  { id: 'mindreach', name: 'MindReach', tag: 'Agentic Growth', title: 'Move growth from passive discovery to intelligent connection', desc: 'MindReach uses AI agents to sense demand signals, understand account context, shape high-quality communication, and connect meaningful opportunities to enterprise growth systems.', points: ['Demand signal discovery', 'Account context understanding', 'Intelligent message generation', 'High-intent opportunity connection'] },
];
const principles = [
  { title: 'Brand position first', desc: 'Every intelligent capability serves how the enterprise should be understood in the market' },
  { title: 'Trust through proof', desc: 'Cases, perspectives, credentials, and expertise become the basis of AI confidence' },
  { title: 'Agents for growth', desc: 'Market signals and customer context become a higher-quality growth loop' },
  { title: 'Governed consistency', desc: 'Brand expression, AI answers, and growth activity remain aligned over time' },
];
---
<BaseLayout title="FrontMind Solutions - Brand Growth Architecture for the AI Era" description="FrontMind builds brand semantics, AI trust, and agentic growth systems through MindPromise and MindReach." lang="en" includeChrome={true} currentPath="/en/solutions">
  <section class="relative overflow-hidden pt-32 pb-24"><div class="absolute inset-0 opacity-[0.05]" style="background-image: radial-gradient(circle at 18% 14%, #3D1560 0, transparent 30%), radial-gradient(circle at 88% 0%, #C5A24D 0, transparent 24%);"></div><div class="container relative z-10"><div class="max-w-4xl"><AstroSectionLabel text="Solutions" color="gold" /><h1 class="mb-7 text-5xl font-bold leading-tight text-[#1A1A2E] md:text-7xl" style="font-family: 'DM Serif Display', serif;">Brand growth architecture for the AI era</h1><p class="max-w-3xl text-lg leading-relaxed text-[#6B7280]" style="font-family: 'DM Sans', sans-serif;">FrontMind connects brand strategy, semantic assets, and agentic intelligence to help enterprises be correctly understood, continuously trusted, and meaningfully selected across generative engines, AI search, and intelligent commercial interfaces.</p></div></div></section>
  <section class="bg-[#FBFAFC] py-20 md:py-28"><div class="container"><div class="mx-auto mb-14 max-w-3xl text-center"><AstroSectionLabel text="Core Systems" color="purple" /><h2 class="mb-5 text-4xl font-bold leading-tight text-[#1A1A2E] md:text-6xl" style="font-family: 'DM Serif Display', serif;">From being understood to being chosen</h2><p class="mx-auto max-w-2xl text-base leading-relaxed text-[#6B7280]" style="font-family: 'DM Sans', sans-serif;">MindPromise shapes how the brand is understood and trusted by AI. MindReach connects demand signals with intelligent growth action.</p></div><div class="grid grid-cols-1 gap-8 lg:grid-cols-2">{systems.map((item, index) => <article id={item.id} class={index === 1 ? 'fm-emphasis-card p-9 md:p-12' : 'fm-card p-9 md:p-12'}><div class="mb-7 rounded-2xl bg-[#1A1A2E] px-6 py-5 text-white"><div class="text-xs uppercase tracking-[0.24em] text-[#C5A24D]" style="font-family: 'DM Sans', sans-serif;">{item.tag}</div><h2 class="mt-3 text-4xl font-bold leading-tight" style="font-family: 'DM Serif Display', serif;">{item.name}</h2></div><h3 class="mb-5 text-3xl font-bold leading-tight text-[#1A1A2E] md:text-4xl" style="font-family: 'DM Serif Display', serif;">{item.title}</h3><p class="mb-7 max-w-xl leading-relaxed text-[#6B7280]" style="font-family: 'DM Sans', sans-serif;">{item.desc}</p><div class="grid grid-cols-1 gap-3 md:grid-cols-2">{item.points.map((point) => <div class="fm-card-soft px-4 py-3 text-sm font-medium text-[#1A1A2E]" style="font-family: 'DM Sans', sans-serif;">{point}</div>)}</div></article>)}</div></div></section>
  <section class="bg-white py-20 md:py-28"><div class="container"><div class="mx-auto mb-12 max-w-3xl text-center"><AstroSectionLabel text="Principles" color="gold" /><h2 class="mb-5 text-4xl font-bold leading-tight text-[#1A1A2E] md:text-6xl" style="font-family: 'DM Serif Display', serif;">Let technology serve brand order</h2><p class="mx-auto max-w-2xl text-[#6B7280]" style="font-family: 'DM Sans', sans-serif;">Valuable enterprise AI is not about pushing more information into the market. It is about keeping the brand’s core value clear, credible, and consistent across intelligent interfaces.</p></div><div class="grid grid-cols-1 gap-5 md:grid-cols-4">{principles.map((item, index) => <article class="fm-card-soft p-7"><div class="mb-5 text-xs font-bold uppercase tracking-[0.22em] text-[#C5A24D]">0{index + 1}</div><h3 class="mb-3 text-xl font-bold text-[#1A1A2E]" style="font-family: 'DM Serif Display', serif;">{item.title}</h3><p class="text-sm leading-relaxed text-[#6B7280]" style="font-family: 'DM Sans', sans-serif;">{item.desc}</p></article>)}</div></div></section>
  <section class="bg-[#FBFAFC] py-20"><div class="container"><div class="fm-emphasis-card p-9 text-center md:p-14"><h2 class="mb-5 text-4xl font-bold leading-tight text-[#1A1A2E] md:text-6xl" style="font-family: 'DM Serif Display', serif;">Be correctly selected in AI interfaces</h2><p class="mx-auto mb-8 max-w-2xl text-[#6B7280]" style="font-family: 'DM Sans', sans-serif;">FrontMind works with leadership teams to define the brand position, semantic assets, and intelligent growth capability that should become durable enterprise advantage.</p><a href="/en/contact" class="inline-flex rounded-md bg-[#3D1560] px-7 py-4 text-sm font-bold text-white no-underline">Start a strategic conversation</a></div></div></section>
</BaseLayout>
