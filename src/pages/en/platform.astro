---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AstroSectionLabel from '../../components/AstroSectionLabel.astro';
const layers = [
  { title: 'Strategic Layer', desc: 'Define how the enterprise should be understood, trusted, and selected in AI-mediated decisions' },
  { title: 'Semantic Layer', desc: 'Turn positioning, content, cases, perspectives, and proof into brand assets AI can interpret' },
  { title: 'Agentic Layer', desc: 'Use AI agents to sense demand, understand customer context, and connect high-intent opportunities' },
  { title: 'Governance Layer', desc: 'Maintain consistency across brand expression, AI answers, and market movement over time' },
];
const disciplines = ['Brand Strategy', 'Semantic Intelligence', 'Multi-Agent Systems', 'Content Assets', 'Trust Evidence', 'Growth Intelligence'];
---
<BaseLayout title="FrontMind Methodology - Brand Intelligence Architecture" description="FrontMind builds brand intelligence across strategy, semantics, agents, and long-term governance." lang="en" includeChrome={true} currentPath="/en/platform">
  <section class="relative overflow-hidden pt-32 pb-24"><div class="absolute inset-0 opacity-[0.05]" style="background-image: radial-gradient(circle at 18% 14%, #3D1560 0, transparent 30%), radial-gradient(circle at 88% 0%, #C5A24D 0, transparent 24%);"></div><div class="container relative z-10"><div class="max-w-4xl"><AstroSectionLabel text="Methodology" color="gold" /><h1 class="mb-7 text-5xl font-bold leading-tight text-[#1A1A2E] md:text-7xl" style="font-family: 'DM Serif Display', serif;">A system methodology for brand intelligence</h1><p class="max-w-3xl text-lg leading-relaxed text-[#6B7280]" style="font-family: 'DM Sans', sans-serif;">FrontMind’s methodology is not a checklist. It is an architecture for the AI era, connecting strategic judgment, semantic assets, agentic capability, and long-term governance into one system.</p></div></div></section>
  <section class="bg-white py-20 md:py-28"><div class="container"><div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-4">{layers.map((item) => <article class="fm-card p-8"><div class="mb-2 text-sm font-bold uppercase tracking-[0.16em] text-[#3D1560]" style="font-family: 'DM Sans', sans-serif;">{item.title}</div><h2 class="mb-4 text-3xl font-bold text-[#1A1A2E]" style="font-family: 'DM Serif Display', serif;">{item.title.replace(' Layer', '')}</h2><p class="text-sm leading-relaxed text-[#6B7280]" style="font-family: 'DM Sans', sans-serif;">{item.desc}</p></article>)}</div></div></section>
  <section class="bg-[#1A1A2E] py-20 text-white md:py-28"><div class="container"><div class="grid grid-cols-1 gap-12 lg:grid-cols-12"><div class="lg:col-span-5"><AstroSectionLabel text="Architecture" color="gold" /><h2 class="mb-6 text-4xl font-bold leading-tight md:text-6xl" style="font-family: 'DM Serif Display', serif;">The most valuable AI capability lets brand and system speak the same language</h2><p class="text-base leading-relaxed text-white/70" style="font-family: 'DM Sans', sans-serif;">When positioning, content, proof, and growth activity can be consistently interpreted by intelligent systems, AI becomes part of long-term brand advantage.</p></div><div class="lg:col-span-7"><div class="grid grid-cols-2 gap-4 md:grid-cols-3">{disciplines.map((item) => <div class="rounded-2xl border border-white/10 bg-white/5 p-6 text-center text-base font-bold text-white" style="font-family: 'DM Serif Display', serif;">{item}</div>)}</div></div></div></div></section>
  <section class="bg-[#FBFAFC] py-20"><div class="container"><div class="fm-emphasis-card p-9 text-center md:p-14"><h2 class="mb-5 text-4xl font-bold leading-tight text-[#1A1A2E] md:text-6xl" style="font-family: 'DM Serif Display', serif;">Discuss brand intelligence architecture with FrontMind</h2><p class="mx-auto mb-8 max-w-2xl text-[#6B7280]" style="font-family: 'DM Sans', sans-serif;">Start from your brand position, industry context, and growth ambition to define the system capability worth building for the AI era.</p><a href="/en/contact" class="inline-flex rounded-md bg-[#3D1560] px-7 py-4 text-sm font-bold text-white no-underline">Start a strategic conversation</a></div></div></section>
</BaseLayout>
