---
import BaseLayout from '../layouts/BaseLayout.astro';
import AstroSectionLabel from '../components/AstroSectionLabel.astro';

const topics = ['企业 AI 战略', '品牌语义资产', '智能体增长系统', '组织级落地能力'];
---

<BaseLayout
  title="联系 FrontMind - 战略咨询"
  description="与 FrontMind 开始一次关于企业 AI 战略、品牌语义与智能增长系统的高质量对话。"
  lang="zh"
  includeChrome={true}
  currentPath="/contact"
>
  <section class="relative overflow-hidden pt-32 pb-24">
    <div class="absolute inset-0 opacity-[0.05]" style="background-image: radial-gradient(circle at 18% 14%, #3D1560 0, transparent 30%), radial-gradient(circle at 88% 0%, #C5A24D 0, transparent 24%);"></div>
    <div class="container relative z-10">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <AstroSectionLabel text="Contact" color="gold" />
          <h1 class="mb-7 text-5xl font-bold leading-tight text-[#1A1A2E] md:text-7xl" style="font-family: 'DM Serif Display', serif;">开启一次高质量的 AI 战略对话</h1>
          <p class="max-w-2xl text-lg leading-relaxed text-[#6B7280]" style="font-family: 'DM Sans', sans-serif;">如果企业正在重新思考 AI 时代的品牌理解、增长秩序与组织能力，FrontMind 可以与你共同定义值得长期拥有的系统优势。</p>
          <div class="mt-9 flex flex-wrap gap-3">
            {topics.map((item) => <span class="rounded-full border border-[#3D1560]/10 bg-white px-4 py-2 text-xs font-bold uppercase tracking-[0.16em] text-[#3D1560]" style="font-family: 'DM Sans', sans-serif;">{item}</span>)}
          </div>
        </div>
        <div class="lg:col-span-5">
          <div class="fm-emphasis-card p-9 md:p-12">
            <h2 class="mb-5 text-4xl font-bold leading-tight text-[#1A1A2E]" style="font-family: 'DM Serif Display', serif;">Strategic Conversation</h2>
            <p class="mb-8 text-sm leading-relaxed text-[#6B7280]" style="font-family: 'DM Sans', sans-serif;">请简要说明企业所处行业、当前 AI 议题与希望建立的能力方向。我们会以管理层视角回应，并建议合适的下一步。</p>
            <a href="mailto:hello@frontmind.net?subject=FrontMind Strategic Conversation" class="inline-flex w-full justify-center rounded-md bg-[#3D1560] px-6 py-4 text-sm font-bold text-white no-underline">发送邮件</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
