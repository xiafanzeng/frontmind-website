---
import BaseLayout from '../layouts/BaseLayout.astro';
import AstroSectionLabel from '../components/AstroSectionLabel.astro';

const topics = ['企业 AI 战略', '品牌语义资产', '智能体增长系统', '组织级落地能力'];
const emails = ['fanzengxia@link.cuhk.edu.cn', 'litongxin@cuhk.edu.cn'];
const mailSubject = 'FrontMind 商务沟通｜公司名称';
const mailBody = [
  '公司名称：',
  '您的姓名与职务：',
  '公司官网：',
  '公司介绍材料：',
  '希望讨论的方向：',
  '当前业务背景：',
  '期待的下一步：',
].join('\n');
const mailtoHref = (email: string) => `mailto:${email}?subject=${encodeURIComponent(mailSubject)}&body=${encodeURIComponent(mailBody)}`;
const briefingItems = ['公司背景', '沟通身份', '讨论目标'];
const sampleLines = [
  '邮件标题：FrontMind 商务沟通｜公司名称',
  '',
  '您好，FrontMind 团队：',
  '',
  '我们来自公司名称，官网为公司官网。我是姓名，负责相关职能。',
  '',
  '随信附上公司介绍材料，供团队了解业务背景。',
  '',
  '本次希望重点讨论：品牌在生成式答案中的可见度、智能体增长机会，或企业内部 AI 工作流部署。',
  '',
  '如方向匹配，期待安排一次初步沟通。',
  '',
  '谢谢。',
].join('\n');
---

<BaseLayout
  title="联系 FrontMind - 战略咨询"
  description="联系 FrontMind，讨论 GEO、AI 品牌可见度、智能体增长、企业级 AI 工作流部署与 FDE 入驻。"
  lang="zh"
  includeChrome={true}
  currentPath="/contact"
>
  <section class="relative overflow-hidden pt-32 pb-24">
    <div class="absolute inset-0 opacity-[0.05]" style="background-image: radial-gradient(circle at 18% 14%, #3D1560 0, transparent 30%), radial-gradient(circle at 88% 0%, #C5A24D 0, transparent 24%);"></div>
    <div class="container relative z-10">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <AstroSectionLabel text="Contact" color="gold" />
          <h1 class="mb-7 text-5xl font-bold leading-tight text-[#1A1A2E] md:text-7xl" style="font-family: 'DM Serif Display', serif;">与 FrontMind 开启一次业务讨论</h1>
          <p class="max-w-2xl text-lg leading-relaxed text-[#6B7280]" style="font-family: 'DM Sans', sans-serif;">如果企业正在思考 AI 搜索可见度、智能体增长或内部流程 AI 化，欢迎将业务背景与合作方向发送给我们。</p>
          <div class="mt-9 flex flex-wrap gap-3">
            {topics.map((item) => <span class="rounded-full border border-[#3D1560]/10 bg-white px-4 py-2 text-xs font-bold uppercase tracking-[0.16em] text-[#3D1560]" style="font-family: 'DM Sans', sans-serif;">{item}</span>)}
          </div>
        </div>
        <div class="lg:col-span-5">
          <div class="fm-emphasis-card p-9 md:p-12">
            <h2 class="mb-5 text-4xl font-bold leading-tight text-[#1A1A2E]" style="font-family: 'DM Serif Display', serif;">Strategic Conversation</h2>
            <p class="mb-8 text-sm leading-relaxed text-[#6B7280]" style="font-family: 'DM Sans', sans-serif;">来信可简要说明公司背景、您的职务、公司介绍材料与希望讨论的重点。FrontMind 团队会基于材料判断适合的交流方式。</p>
            <div class="space-y-3">
              {emails.map((email) => <a href={mailtoHref(email)} class="inline-flex w-full justify-center rounded-md bg-[#3D1560] px-6 py-4 text-sm font-bold text-white no-underline">{email}</a>)}
            </div>
          </div>
        </div>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-8 lg:grid-cols-12">
        <div class="fm-card p-7 lg:col-span-5">
          <h2 class="mb-5 text-3xl font-bold leading-tight text-[#1A1A2E]" style="font-family: 'DM Serif Display', serif;">来信建议</h2>
          <ul class="space-y-3">
            {briefingItems.map((item) => <li class="text-sm leading-relaxed text-[#4B5563]" style="font-family: 'DM Sans', sans-serif;">• {item}</li>)}
          </ul>
        </div>
        <div class="fm-emphasis-card p-7 lg:col-span-7">
          <h2 class="mb-5 text-3xl font-bold leading-tight text-[#1A1A2E]" style="font-family: 'DM Serif Display', serif;">来信示例</h2>
          <pre class="whitespace-pre-wrap border-l-2 border-[#C5A24D] bg-white px-5 py-4 text-sm leading-relaxed text-[#4B5563]" style="font-family: 'DM Sans', sans-serif;">{sampleLines}</pre>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
