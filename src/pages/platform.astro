---
import BaseLayout from '../layouts/BaseLayout.astro';
import AstroSectionLabel from '../components/AstroSectionLabel.astro';

const layers = [
  { title: 'Strategic Layer', zh: '战略层', desc: '明确企业在 AI 时代应被如何理解、因何被信任、凭什么被选择' },
  { title: 'Semantic Layer', zh: '语义层', desc: '将定位、内容、案例、观点与证据组织为可被智能系统解释的品牌资产' },
  { title: 'Agentic Layer', zh: '智能体层', desc: '让 AI Agent 识别需求信号、理解客户语境，并辅助形成高质量连接' },
  { title: 'Governance Layer', zh: '治理层', desc: '持续校准品牌表达、AI 回答与增长动作之间的一致性' },
];
const disciplines = ['品牌战略', '语义智能', '多智能体系统', '内容资产', '信任证据', '增长智能'];
---

<BaseLayout title="FrontMind 方法论 - AI 时代品牌智能架构" description="FrontMind 以战略层、语义层、智能体层与治理层，构建面向 AI 时代的品牌智能方法论。" lang="zh" includeChrome={true} currentPath="/platform">
  <section class="relative overflow-hidden pt-32 pb-24">
    <div class="absolute inset-0 opacity-[0.05]" style="background-image: radial-gradient(circle at 18% 14%, #3D1560 0, transparent 30%), radial-gradient(circle at 88% 0%, #C5A24D 0, transparent 24%);"></div>
    <div class="container relative z-10">
      <div class="max-w-4xl">
        <AstroSectionLabel text="Methodology" color="gold" />
        <h1 class="mb-7 text-5xl font-bold leading-tight text-[#1A1A2E] md:text-7xl" style="font-family: 'DM Serif Display', serif;">品牌智能的系统方法论</h1>
        <p class="max-w-3xl text-lg leading-relaxed text-[#6B7280]" style="font-family: 'DM Sans', sans-serif;">FrontMind 的方法论不是流程清单，而是一套面向 AI 时代的品牌智能架构。它帮助企业把战略判断、语义资产、智能体能力与长期治理连接为一个整体。</p>
      </div>
    </div>
  </section>

  <section class="bg-white py-20 md:py-28">
    <div class="container">
      <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-4">
        {layers.map((item, index) => (
          <article class="fm-card p-8">
            <div class="mb-2 text-sm font-bold uppercase tracking-[0.16em] text-[#3D1560]" style="font-family: 'DM Sans', sans-serif;">{item.title}</div>
            <h2 class="mb-4 text-3xl font-bold text-[#1A1A2E]" style="font-family: 'DM Serif Display', serif;">{item.zh}</h2>
            <p class="text-sm leading-relaxed text-[#6B7280]" style="font-family: 'DM Sans', sans-serif;">{item.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-[#1A1A2E] py-20 text-white md:py-28">
    <div class="container">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <AstroSectionLabel text="Architecture" color="gold" />
          <h2 class="mb-6 text-4xl font-bold leading-tight md:text-6xl" style="font-family: 'DM Serif Display', serif;">真正高级的 AI 能力，是让品牌与系统形成同一种语言</h2>
          <p class="text-base leading-relaxed text-white/70" style="font-family: 'DM Sans', sans-serif;">当企业的定位、内容、证据和增长动作能够被智能系统一致理解，AI 才不只是效率工具，而会成为品牌长期优势的一部分。</p>
        </div>
        <div class="lg:col-span-7">
          <div class="grid grid-cols-2 gap-4 md:grid-cols-3">
            {disciplines.map((item) => (
              <div class="rounded-2xl border border-white/10 bg-white/5 p-6 text-center text-base font-bold text-white" style="font-family: 'DM Serif Display', serif;">{item}</div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#FBFAFC] py-20">
    <div class="container">
      <div class="fm-emphasis-card p-9 text-center md:p-14">
        <h2 class="mb-5 text-4xl font-bold leading-tight text-[#1A1A2E] md:text-6xl" style="font-family: 'DM Serif Display', serif;">与 FrontMind 讨论品牌智能架构</h2>
        <p class="mx-auto mb-8 max-w-2xl text-[#6B7280]" style="font-family: 'DM Sans', sans-serif;">从企业的品牌位置、行业语境与增长目标出发，定义 AI 时代真正值得建设的系统能力。</p>
        <a href="/contact" class="inline-flex rounded-md bg-[#3D1560] px-7 py-4 text-sm font-bold text-white no-underline">开启战略对话</a>
      </div>
    </div>
  </section>
</BaseLayout>
