---
import BaseLayout from '../layouts/BaseLayout.astro';
import AstroSectionLabel from '../components/AstroSectionLabel.astro';

const values = [
  { title: '研究驱动', desc: '以学术方法、数据判断与模型理解作为品牌智能系统的底层依据' },
  { title: '品牌敬畏', desc: '尊重企业长期积累的声誉、专业性与信任资产，而不是用技术语言替代品牌语言' },
  { title: '工程深度', desc: '将自然语言处理、多智能体系统与企业级产品能力连接到真实商业语境' },
  { title: '长期主义', desc: '关注品牌在 AI 环境中的持续表达、持续被理解与持续被选择' },
];

const teamStats = [
  { value: '80%', label: '硕博背景团队成员' },
  { value: '10+', label: '平均产业与研究经验' },
  { value: '30+', label: '相关论文与研究积累' },
  { value: '5+', label: '核心技术专利方向' },
];

const foundations = [
  '诞生于香港中文大学（深圳）创新生态',
  '依托智能决策实验室的研究能力与算力背景',
  '团队来自港中大（深圳）、加州理工、港大、清华、纽约大学等学术体系',
  '在自然语言处理、多智能体系统、强化学习与品牌语义方向持续积累',
];

const credibilityPillars = [
  { label: 'Research', title: '研究能力', desc: '围绕自然语言处理、多智能体系统、强化学习与品牌语义持续积累方法论。' },
  { label: 'Recognition', title: '创新认可', desc: '获得“未来中国香港”创科大赛冠军与中国创新创业大赛等创新体系认可。' },
  { label: 'Product', title: '产品体系', desc: '以 MindPromise 智诺与 MindReach 智达连接品牌语义、信任证据与智能增长。' },
  { label: 'Practice', title: '产业理解', desc: '面向教育、科技、医疗、金融等高信任行业，将研究能力转化为企业可执行的品牌智能系统。' },
];
---

<BaseLayout title="关于 FrontMind - AI 时代品牌智能公司" description="FrontMind 源自香港中文大学（深圳）创新生态，将品牌战略、语义智能与 AI Agent 能力结合，帮助高信任企业在 AI 时代被理解、被信任、被选择。" lang="zh" includeChrome={true} currentPath="/about">
  <section class="relative overflow-hidden bg-white pt-32 pb-24">
    <div class="absolute inset-0 opacity-[0.04]" style="background-image: radial-gradient(circle at 20% 10%, #3D1560 0, transparent 28%), radial-gradient(circle at 88% 0%, #C5A24D 0, transparent 22%);"></div>
    <div class="container relative z-10">
      <div class="max-w-4xl">
        <AstroSectionLabel text="About FrontMind" color="gold" />
        <h1 class="mb-7 text-5xl font-bold leading-tight text-[#1A1A2E] md:text-7xl" style="font-family: 'DM Serif Display', serif;">源于研究，为品牌而生</h1>
        <p class="max-w-3xl text-lg leading-relaxed text-[#6B7280]" style="font-family: 'DM Sans', sans-serif;">FrontMind 超前智能诞生于香港中文大学（深圳）创新生态。我们相信，生成式 AI 正在重写品牌被发现、被理解与被信任的方式。企业不只需要更多内容，也不只是需要更多工具，而是需要一套能够让品牌在 AI 时代保持清晰、可信与可持续增长的智能系统。</p>
      </div>
    </div>
  </section>

  <section class="bg-[#FBFAFC] py-20 md:py-28">
    <div class="container">
      <div class="grid grid-cols-1 gap-px bg-[#e5e7eb] md:grid-cols-2">
        <div class="bg-white p-8 md:p-10">
          <div class="mb-5 h-px w-12 bg-[#C5A24D]"></div>
          <h2 class="mb-4 text-3xl font-bold text-[#1A1A2E]" style="font-family: 'DM Serif Display', serif;">我们的使命</h2>
          <p class="text-sm leading-relaxed text-[#6B7280]" style="font-family: 'DM Sans', sans-serif;">让企业的真实价值在 AI 时代被准确表达。FrontMind 将品牌定位、专业能力、内容资产与信任证据转化为可被智能系统理解的语义结构，让品牌在新的信息入口中保持应有的位置。</p>
        </div>
        <div class="bg-white p-8 md:p-10">
          <div class="mb-5 h-px w-12 bg-[#C5A24D]"></div>
          <h2 class="mb-4 text-3xl font-bold text-[#1A1A2E]" style="font-family: 'DM Serif Display', serif;">我们的愿景</h2>
          <p class="text-sm leading-relaxed text-[#6B7280]" style="font-family: 'DM Sans', sans-serif;">成为 AI 时代值得信任的品牌智能伙伴，帮助高信任企业建立面向生成式引擎、智能体与未来商业界面的长期竞争力。</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20 md:py-28">
    <div class="container">
      <div class="mb-14 max-w-3xl">
        <AstroSectionLabel text="Our Belief" color="purple" />
        <h2 class="mb-5 text-4xl font-bold leading-tight text-[#1A1A2E] md:text-6xl" style="font-family: 'DM Serif Display', serif;">品牌的下一次优势，来自被 AI 正确理解</h2>
        <p class="text-base leading-relaxed text-[#6B7280]" style="font-family: 'DM Sans', sans-serif;">在搜索时代，品牌争夺可见性；在 AI 时代，品牌争夺解释权。FrontMind 关注的不只是“有没有被提及”，而是 AI 如何理解你的定位、如何引用你的证据、如何向用户解释你的价值，以及这种理解能否长期保持一致。</p>
      </div>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-4">
        {values.map((item) => (
          <article class="fm-card p-7">
            <h3 class="mb-3 text-2xl font-bold text-[#1A1A2E]" style="font-family: 'DM Serif Display', serif;">{item.title}</h3>
            <p class="text-sm leading-relaxed text-[#6B7280]" style="font-family: 'DM Sans', sans-serif;">{item.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-[#FBFAFC] py-20 md:py-28">
    <div class="container">
      <div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <AstroSectionLabel text="Team" color="gold" />
          <h2 class="text-4xl font-bold leading-tight text-[#1A1A2E] md:text-6xl" style="font-family: 'DM Serif Display', serif;">跨学科的精英团队</h2>
        </div>
        <div class="lg:col-span-8">
          <div class="space-y-6">
            <p class="text-base leading-relaxed text-[#4B5563]" style="font-family: 'DM Sans', sans-serif;">FrontMind 的核心团队汇聚人工智能、自然语言处理、品牌战略、商业增长与企业级产品经验。团队成员来自香港中文大学（深圳）、加州理工、香港大学、清华大学、纽约大学等学术体系，并拥有头部科技企业与产业场景中的工程实践背景。</p>
            <p class="text-base leading-relaxed text-[#4B5563]" style="font-family: 'DM Sans', sans-serif;">这种跨学科结构使 FrontMind 能够同时理解模型、理解品牌，也理解企业管理团队在声誉、增长与组织能力之间需要做出的判断。我们不把 AI 视为单一技术，而是将其看作品牌进入下一代商业界面的基础设施。</p>
            <div class="grid grid-cols-2 gap-4 border-t border-[#e8e4ec] pt-6 md:grid-cols-4">
              {teamStats.map((stat) => (
                <div class="fm-card-soft p-4">
                  <div class="text-2xl font-bold italic text-[#3D1560]" style="font-family: 'DM Serif Display', serif;">{stat.value}</div>
                  <div class="mt-1 text-xs text-[#9CA3AF]" style="font-family: 'DM Sans', sans-serif;">{stat.label}</div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20 md:py-28">
    <div class="container">
      <div class="grid grid-cols-1 items-start gap-14 lg:grid-cols-2">
        <div>
          <AstroSectionLabel text="Foundation" color="purple" />
          <h2 class="mb-5 text-4xl font-bold leading-tight text-[#1A1A2E] md:text-6xl" style="font-family: 'DM Serif Display', serif;">根植于研究，也面向真实商业</h2>
          <p class="mb-8 text-base leading-relaxed text-[#6B7280]" style="font-family: 'DM Sans', sans-serif;">FrontMind 的方法论来自对 AI 信息结构、品牌语义资产与智能体能力的持续研究。我们关注技术的边界，也关注企业在复杂市场中如何建立可被识别和信任的长期表达。</p>
          <div class="space-y-3">
            {foundations.map((item) => (
              <div class="fm-card-soft p-4 text-sm font-medium text-[#1A1A2E]" style="font-family: 'DM Sans', sans-serif;">{item}</div>
            ))}
          </div>
        </div>
        <div class="fm-emphasis-card p-8 md:p-10">
          <h3 class="mb-6 text-3xl font-bold text-[#1A1A2E]" style="font-family: 'DM Serif Display', serif;">可信基础</h3>
          <div class="space-y-5">
            {credibilityPillars.map((item) => (
              <div class="border-t border-[#3D1560]/10 pt-5 first:border-t-0 first:pt-0">
                <div class="mb-2 text-xs font-bold uppercase tracking-[0.18em] text-[#C5A24D]" style="font-family: 'DM Sans', sans-serif;">{item.label}</div>
                <h4 class="mb-2 text-base font-bold text-[#1A1A2E]" style="font-family: 'DM Serif Display', serif;">{item.title}</h4>
                <p class="text-sm leading-relaxed text-[#6B7280]" style="font-family: 'DM Sans', sans-serif;">{item.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#1A1A2E] py-20 text-white md:py-28">
    <div class="container">
      <div class="mx-auto max-w-4xl text-center">
        <AstroSectionLabel text="FrontMind" color="gold" />
        <h2 class="mb-6 text-4xl font-bold leading-tight md:text-6xl" style="font-family: 'DM Serif Display', serif;">重新定义品牌在 AI 时代的制胜之道</h2>
        <p class="mx-auto max-w-2xl text-base leading-relaxed text-white/70" style="font-family: 'DM Sans', sans-serif;">我们希望让每一个拥有真实专业能力与长期价值的企业，在 AI 时代被更准确地理解、更恰当地呈现，并被真正需要它的人选择。</p>
      </div>
    </div>
  </section>
</BaseLayout>
