{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["questions"],
  "properties": {
    "questions": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "question",
          "rationale",
          "evidenceRefs",
          "selectable"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(reputation|product-scenario|industry-ranking|competitor-comparison)-0[1-5]$"
          },
          "category": {
            "enum": [
              "reputation",
              "product_scenario",
              "industry_ranking",
              "competitor_comparison"
            ]
          },
          "question": {
            "type": "string",
            "minLength": 4,
            "maxLength": 120,
            "pattern": "？$"
          },
          "rationale": { "type": "string", "minLength": 4, "maxLength": 240 },
          "enterpriseAnchor": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "offeringAnchor": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "qaIntent": {
            "enum": [
              "offering_definition",
              "feature_mechanism",
              "scenario_fit",
              "delivery_usage",
              "support_boundary"
            ]
          },
          "evidenceRefs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 3, "maxLength": 300 }
          },
          "selectable": { "type": "boolean" }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "category": { "const": "product_scenario" }
              },
              "required": ["category"]
            },
            "then": {
              "required": ["enterpriseAnchor", "offeringAnchor", "qaIntent"]
            }
          }
        ]
      }
    }
  }
}
