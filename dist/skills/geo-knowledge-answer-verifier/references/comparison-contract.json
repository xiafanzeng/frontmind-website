{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FrontMind GEO knowledge-answer comparison item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "topic",
    "verdict",
    "platform",
    "runIndex",
    "answerExcerpt",
    "kbClaimId",
    "kbClaimText",
    "kbEvidenceRefs",
    "explanation",
    "recommendedAction",
    "confidence"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 120 },
    "topic": { "type": "string", "minLength": 2, "maxLength": 120 },
    "verdict": {
      "enum": ["supported", "contradicted", "omitted", "unverifiable"]
    },
    "platform": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 80
    },
    "runIndex": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 5
    },
    "answerExcerpt": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 1200
    },
    "kbClaimId": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 300
    },
    "kbClaimText": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 1200
    },
    "kbEvidenceRefs": {
      "type": "array",
      "maxItems": 30,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "explanation": { "type": "string", "minLength": 8, "maxLength": 1200 },
    "recommendedAction": {
      "type": "string",
      "minLength": 8,
      "maxLength": 1200
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  },
  "allOf": [
    {
      "if": {
        "properties": { "verdict": { "const": "omitted" } }
      },
      "then": {
        "properties": {
          "platform": { "type": "null" },
          "runIndex": { "type": "null" },
          "answerExcerpt": { "type": "null" }
        }
      },
      "else": {
        "properties": {
          "platform": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "runIndex": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "answerExcerpt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "enum": ["supported", "contradicted", "omitted"]
          }
        }
      },
      "then": {
        "properties": {
          "kbClaimId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "kbClaimText": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "kbEvidenceRefs": { "type": "array", "minItems": 1 }
        }
      }
    }
  ]
}
