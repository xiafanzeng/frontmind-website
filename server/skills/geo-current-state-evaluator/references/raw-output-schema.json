{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "assessmentType",
    "question",
    "sample",
    "dimensions",
    "rankingDiagnostics",
    "platformBreakdown",
    "knowledgeVsAnswers",
    "summary",
    "executiveSummary",
    "dimensionNarratives",
    "priorityActions",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "assessmentType": { "const": "question_baseline" },
    "question": { "$ref": "#/$defs/question" },
    "sample": { "$ref": "#/$defs/sample" },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semanticVisibility",
        "semanticCoherence",
        "semanticRichness",
        "semanticAuthority",
        "competitiveAdvantage"
      ],
      "properties": {
        "semanticVisibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "aiSearchVisibility",
            "webSearchSov",
            "multiPlatformCoverage"
          ],
          "properties": {
            "aiSearchVisibility": { "$ref": "#/$defs/indicator" },
            "webSearchSov": { "$ref": "#/$defs/indicator" },
            "multiPlatformCoverage": { "$ref": "#/$defs/indicator" }
          }
        },
        "semanticCoherence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["corePropositionHitRate", "toneConsistency"],
          "properties": {
            "corePropositionHitRate": { "$ref": "#/$defs/indicator" },
            "toneConsistency": { "$ref": "#/$defs/indicator" }
          }
        },
        "semanticRichness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "questionStageCoverage",
            "semanticEntityRichness",
            "contentFormatDiversity"
          ],
          "properties": {
            "questionStageCoverage": { "$ref": "#/$defs/indicator" },
            "semanticEntityRichness": { "$ref": "#/$defs/indicator" },
            "contentFormatDiversity": { "$ref": "#/$defs/indicator" }
          }
        },
        "semanticAuthority": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "authoritativeSourceRatio",
            "structuredDataCompleteness",
            "thirdPartyEndorsement"
          ],
          "properties": {
            "authoritativeSourceRatio": { "$ref": "#/$defs/indicator" },
            "structuredDataCompleteness": { "$ref": "#/$defs/indicator" },
            "thirdPartyEndorsement": { "$ref": "#/$defs/indicator" }
          }
        },
        "competitiveAdvantage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["firstMentionRate", "exclusiveSemanticSpace"],
          "properties": {
            "firstMentionRate": { "$ref": "#/$defs/indicator" },
            "exclusiveSemanticSpace": { "$ref": "#/$defs/indicator" }
          }
        }
      }
    },
    "rankingDiagnostics": { "$ref": "#/$defs/rankingDiagnostics" },
    "platformBreakdown": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "description": "Contains every sample.selectedPlatforms value exactly once; platform set equality is checked separately because standard JSON Schema cannot compare the two arrays.",
      "items": { "$ref": "#/$defs/platformBreakdown" }
    },
    "knowledgeVsAnswers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "description": "Target exactly the 10 most relevant unique topics, ordered by relevance, with one aggregate comparison per topic. Never output the discarded candidate topics or exceed 10 items.",
      "items": { "$ref": "#/$defs/knowledgeComparison" }
    },
    "summary": { "type": "string", "minLength": 20, "maxLength": 3000 },
    "executiveSummary": {
      "type": "string",
      "minLength": 20,
      "maxLength": 600,
      "pattern": "^(?:[^。！？!?]*[。！？!?]?){1,3}$"
    },
    "dimensionNarratives": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semanticVisibility",
        "semanticCoherence",
        "semanticRichness",
        "semanticAuthority",
        "competitiveAdvantage"
      ],
      "properties": {
        "semanticVisibility": { "$ref": "#/$defs/dimensionNarrative" },
        "semanticCoherence": { "$ref": "#/$defs/dimensionNarrative" },
        "semanticRichness": { "$ref": "#/$defs/dimensionNarrative" },
        "semanticAuthority": { "$ref": "#/$defs/dimensionNarrative" },
        "competitiveAdvantage": { "$ref": "#/$defs/dimensionNarrative" }
      }
    },
    "priorityActions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/priorityAction" }
    },
    "limitations": {
      "type": "array",
      "maxItems": 30,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "question": {
            "type": "object",
            "properties": {
              "rankingMetricEligible": { "const": false }
            },
            "required": ["rankingMetricEligible"]
          }
        },
        "required": ["question"]
      },
      "then": {
        "type": "object",
        "properties": {
          "rankingDiagnostics": {
            "type": "object",
            "properties": { "eligible": { "const": false } },
            "required": ["eligible"]
          }
        }
      },
      "else": {
        "type": "object",
        "properties": {
          "rankingDiagnostics": {
            "type": "object",
            "properties": { "eligible": { "const": true } },
            "required": ["eligible"]
          }
        }
      }
    }
  ],
  "$defs": {
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "category", "rankingMetricEligible"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 80 },
        "text": { "type": "string", "minLength": 4, "maxLength": 500 },
        "category": {
          "enum": [
            "reputation",
            "product_scenario",
            "industry_ranking",
            "competitor_comparison"
          ]
        },
        "rankingMetricEligible": { "type": "boolean" }
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selectedPlatforms",
        "repeatPerPlatform",
        "expectedResponses",
        "successfulResponses",
        "failedResponses"
      ],
      "properties": {
        "selectedPlatforms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 80 }
        },
        "repeatPerPlatform": {
          "const": 5,
          "description": "Every selected platform always declares five run slots."
        },
        "expectedResponses": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000,
          "description": "Must equal selectedPlatforms.length multiplied by repeatPerPlatform; this cross-field arithmetic is checked separately."
        },
        "successfulResponses": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000,
          "description": "Together with failedResponses must sum to expectedResponses; this cross-field arithmetic is checked separately."
        },
        "failedResponses": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000,
          "description": "Together with successfulResponses must sum to expectedResponses; this cross-field arithmetic is checked separately."
        }
      }
    },
    "indicator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rawValue",
        "measurementStatus",
        "confidence",
        "calculationBasis",
        "limitations"
      ],
      "properties": {
        "rawValue": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "measurementStatus": {
          "enum": ["measured", "derived"]
        },
        "confidence": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "calculationBasis": {
          "type": "string",
          "minLength": 8,
          "maxLength": 1200
        },
        "evidenceRefs": {
          "type": "array",
          "maxItems": 40,
          "default": [],
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "limitations": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "rankingDiagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligible",
        "totalObservations",
        "rankedObservations",
        "unmentionedObservations",
        "averageRank",
        "firstPlaceRate",
        "top3Rate",
        "top5Rate",
        "competitorRankGap",
        "calculationBasis"
      ],
      "properties": {
        "eligible": { "type": "boolean" },
        "totalObservations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000,
          "description": "For eligible diagnostics, must equal rankedObservations plus unmentionedObservations; standard JSON Schema cannot express this arithmetic invariant."
        },
        "rankedObservations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "unmentionedObservations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "averageRank": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "firstPlaceRate": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "top3Rate": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "top5Rate": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "competitorRankGap": { "type": ["number", "null"] },
        "calculationBasis": {
          "type": "string",
          "minLength": 8,
          "maxLength": 1200
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": { "eligible": { "const": false } },
            "required": ["eligible"]
          },
          "then": {
            "type": "object",
            "properties": {
              "totalObservations": { "const": 0 },
              "rankedObservations": { "const": 0 },
              "unmentionedObservations": { "const": 0 },
              "averageRank": { "type": "null" },
              "firstPlaceRate": { "type": "null" },
              "top3Rate": { "type": "null" },
              "top5Rate": { "type": "null" },
              "competitorRankGap": { "type": "null" }
            }
          }
        }
      ]
    },
    "platformBreakdown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "responseCount",
        "successfulResponses",
        "brandMentionRate",
        "averageRank",
        "factAccuracy",
        "propositionHitRate",
        "sourceCount",
        "sentiment",
        "verdict"
      ],
      "properties": {
        "platform": { "type": "string", "minLength": 1, "maxLength": 80 },
        "responseCount": {
          "const": 5,
          "description": "The five declared run slots for this selected platform, including failed runs."
        },
        "successfulResponses": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "description": "Must not exceed responseCount. Values across platformBreakdown must sum to sample.successfulResponses; those cross-field checks are performed separately."
        },
        "brandMentionRate": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "averageRank": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "factAccuracy": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "propositionHitRate": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "sourceCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "sentiment": {
          "enum": ["positive", "neutral", "negative", "mixed", "unknown"]
        },
        "verdict": { "type": "string", "minLength": 8, "maxLength": 1000 },
        "evidenceRefs": {
          "type": "array",
          "maxItems": 40,
          "default": [],
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "knowledgeComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "topic",
        "verdict",
        "platform",
        "runIndex",
        "answerExcerpt",
        "kbClaimId",
        "kbClaimText",
        "explanation",
        "recommendedAction",
        "confidence"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 120 },
        "topic": { "type": "string", "minLength": 2, "maxLength": 120 },
        "verdict": {
          "enum": ["supported", "contradicted", "omitted", "unverifiable"]
        },
        "platform": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 80
        },
        "runIndex": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 5
        },
        "answerExcerpt": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 1200
        },
        "kbClaimId": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 300
        },
        "kbClaimText": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 1200
        },
        "kbEvidenceRefs": {
          "type": "array",
          "maxItems": 30,
          "default": [],
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "explanation": {
          "type": "string",
          "minLength": 8,
          "maxLength": 1200
        },
        "recommendedAction": {
          "type": "string",
          "minLength": 8,
          "maxLength": 1200
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": { "verdict": { "const": "omitted" } }
          },
          "then": {
            "type": "object",
            "properties": {
              "platform": { "type": "null" },
              "runIndex": { "type": "null" },
              "answerExcerpt": { "type": "null" }
            }
          },
          "else": {
            "type": "object",
            "properties": {
              "platform": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "runIndex": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "answerExcerpt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1200
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "verdict": {
                "enum": ["supported", "contradicted", "omitted"]
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "kbClaimId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "kbClaimText": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1200
              }
            }
          }
        }
      ]
    },
    "dimensionNarrative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currentFinding", "nextAction"],
      "properties": {
        "currentFinding": {
          "type": "string",
          "minLength": 8,
          "maxLength": 260
        },
        "nextAction": { "type": "string", "minLength": 8, "maxLength": 260 }
      }
    },
    "priorityAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["priority", "dimension", "action", "expectedImpact"],
      "properties": {
        "priority": { "type": "integer", "minimum": 1, "maximum": 20 },
        "dimension": {
          "enum": [
            "semanticVisibility",
            "semanticCoherence",
            "semanticRichness",
            "semanticAuthority",
            "competitiveAdvantage"
          ]
        },
        "action": { "type": "string", "minLength": 8, "maxLength": 1000 },
        "expectedImpact": {
          "type": "string",
          "minLength": 4,
          "maxLength": 500
        },
        "evidenceRefs": {
          "type": "array",
          "maxItems": 30,
          "default": [],
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    }
  }
}
