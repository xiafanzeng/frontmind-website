{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "assessmentType",
    "question",
    "sample",
    "dimensions",
    "rankingDiagnostics",
    "platformBreakdown",
    "knowledgeVsAnswers",
    "summary",
    "priorityActions",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "assessmentType": { "const": "question_baseline" },
    "question": { "$ref": "#/$defs/question" },
    "sample": { "$ref": "#/$defs/sample" },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semanticVisibility",
        "semanticCoherence",
        "semanticRichness",
        "semanticAuthority",
        "competitiveAdvantage"
      ],
      "properties": {
        "semanticVisibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "aiSearchVisibility",
            "webSearchSov",
            "multiPlatformCoverage"
          ],
          "properties": {
            "aiSearchVisibility": { "$ref": "#/$defs/indicator" },
            "webSearchSov": { "$ref": "#/$defs/indicator" },
            "multiPlatformCoverage": { "$ref": "#/$defs/indicator" }
          }
        },
        "semanticCoherence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["corePropositionHitRate", "toneConsistency"],
          "properties": {
            "corePropositionHitRate": { "$ref": "#/$defs/indicator" },
            "toneConsistency": { "$ref": "#/$defs/indicator" }
          }
        },
        "semanticRichness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "questionStageCoverage",
            "semanticEntityRichness",
            "contentFormatDiversity"
          ],
          "properties": {
            "questionStageCoverage": { "$ref": "#/$defs/indicator" },
            "semanticEntityRichness": { "$ref": "#/$defs/indicator" },
            "contentFormatDiversity": { "$ref": "#/$defs/indicator" }
          }
        },
        "semanticAuthority": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "authoritativeSourceRatio",
            "structuredDataCompleteness",
            "thirdPartyEndorsement"
          ],
          "properties": {
            "authoritativeSourceRatio": { "$ref": "#/$defs/indicator" },
            "structuredDataCompleteness": { "$ref": "#/$defs/indicator" },
            "thirdPartyEndorsement": { "$ref": "#/$defs/indicator" }
          }
        },
        "competitiveAdvantage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["firstMentionRate", "exclusiveSemanticSpace"],
          "properties": {
            "firstMentionRate": { "$ref": "#/$defs/indicator" },
            "exclusiveSemanticSpace": { "$ref": "#/$defs/indicator" }
          }
        }
      }
    },
    "rankingDiagnostics": { "$ref": "#/$defs/rankingDiagnostics" },
    "platformBreakdown": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/platformBreakdown" }
    },
    "knowledgeVsAnswers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": { "$ref": "#/$defs/knowledgeComparison" }
    },
    "summary": { "type": "string", "minLength": 20, "maxLength": 3000 },
    "priorityActions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/priorityAction" }
    },
    "limitations": {
      "type": "array",
      "maxItems": 30,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    }
  },
  "$defs": {
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "category", "rankingMetricEligible"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 80 },
        "text": { "type": "string", "minLength": 4, "maxLength": 500 },
        "category": {
          "enum": [
            "reputation",
            "product_scenario",
            "industry_ranking",
            "competitor_comparison"
          ]
        },
        "rankingMetricEligible": { "type": "boolean" }
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selectedPlatforms",
        "repeatPerPlatform",
        "expectedResponses",
        "successfulResponses",
        "failedResponses"
      ],
      "properties": {
        "selectedPlatforms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 80 }
        },
        "repeatPerPlatform": { "const": 5 },
        "expectedResponses": { "type": "integer", "minimum": 1 },
        "successfulResponses": { "type": "integer", "minimum": 0 },
        "failedResponses": { "type": "integer", "minimum": 0 }
      }
    },
    "indicator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rawValue",
        "measurementStatus",
        "confidence",
        "calculationBasis",
        "evidenceRefs",
        "limitations"
      ],
      "properties": {
        "rawValue": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "measurementStatus": {
          "enum": ["measured", "derived", "unavailable"]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "calculationBasis": {
          "type": "string",
          "minLength": 8,
          "maxLength": 1200
        },
        "evidenceRefs": {
          "type": "array",
          "maxItems": 40,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "limitations": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "measurementStatus": { "const": "unavailable" } }
          },
          "then": {
            "properties": {
              "rawValue": { "type": "null" },
              "confidence": { "const": 0 },
              "limitations": { "type": "array", "minItems": 1 }
            }
          },
          "else": {
            "properties": {
              "rawValue": { "type": "number", "minimum": 0, "maximum": 1 },
              "evidenceRefs": { "type": "array", "minItems": 1 }
            }
          }
        }
      ]
    },
    "rankingDiagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligible",
        "totalObservations",
        "rankedObservations",
        "unmentionedObservations",
        "averageRank",
        "firstPlaceRate",
        "top3Rate",
        "top5Rate",
        "competitorRankGap",
        "calculationBasis"
      ],
      "properties": {
        "eligible": { "type": "boolean" },
        "totalObservations": { "type": "integer", "minimum": 0 },
        "rankedObservations": { "type": "integer", "minimum": 0 },
        "unmentionedObservations": { "type": "integer", "minimum": 0 },
        "averageRank": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "firstPlaceRate": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "top3Rate": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "top5Rate": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "competitorRankGap": { "type": ["number", "null"] },
        "calculationBasis": {
          "type": "string",
          "minLength": 8,
          "maxLength": 1200
        }
      }
    },
    "platformBreakdown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "responseCount",
        "successfulResponses",
        "brandMentionRate",
        "averageRank",
        "factAccuracy",
        "propositionHitRate",
        "citationCount",
        "referenceCount",
        "sentiment",
        "verdict",
        "evidenceRefs"
      ],
      "properties": {
        "platform": { "type": "string", "minLength": 1, "maxLength": 80 },
        "responseCount": { "type": "integer", "minimum": 0 },
        "successfulResponses": { "type": "integer", "minimum": 0 },
        "brandMentionRate": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "averageRank": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "factAccuracy": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "propositionHitRate": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "citationCount": { "type": "integer", "minimum": 0 },
        "referenceCount": { "type": "integer", "minimum": 0 },
        "sentiment": {
          "enum": ["positive", "neutral", "negative", "mixed", "unknown"]
        },
        "verdict": { "type": "string", "minLength": 8, "maxLength": 1000 },
        "evidenceRefs": {
          "type": "array",
          "maxItems": 40,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "successfulResponses": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "then": {
            "properties": {
              "evidenceRefs": { "type": "array", "minItems": 1 }
            }
          }
        }
      ]
    },
    "knowledgeComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "topic",
        "verdict",
        "platform",
        "runIndex",
        "answerExcerpt",
        "kbClaimId",
        "kbClaimText",
        "kbEvidenceRefs",
        "explanation",
        "recommendedAction",
        "confidence"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 120 },
        "topic": { "type": "string", "minLength": 2, "maxLength": 120 },
        "verdict": {
          "enum": ["supported", "contradicted", "omitted", "unverifiable"]
        },
        "platform": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 80
        },
        "runIndex": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 5
        },
        "answerExcerpt": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 1200
        },
        "kbClaimId": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 300
        },
        "kbClaimText": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 1200
        },
        "kbEvidenceRefs": {
          "type": "array",
          "maxItems": 30,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "explanation": {
          "type": "string",
          "minLength": 8,
          "maxLength": 1200
        },
        "recommendedAction": {
          "type": "string",
          "minLength": 8,
          "maxLength": 1200
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "verdict": { "const": "omitted" } }
          },
          "then": {
            "properties": {
              "platform": { "type": "null" },
              "runIndex": { "type": "null" },
              "answerExcerpt": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "platform": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "runIndex": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "answerExcerpt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1200
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verdict": {
                "enum": ["supported", "contradicted", "omitted"]
              }
            }
          },
          "then": {
            "properties": {
              "kbClaimId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "kbClaimText": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1200
              },
              "kbEvidenceRefs": { "type": "array", "minItems": 1 }
            }
          }
        }
      ]
    },
    "priorityAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "priority",
        "dimension",
        "action",
        "expectedImpact",
        "evidenceRefs"
      ],
      "properties": {
        "priority": { "type": "integer", "minimum": 1, "maximum": 20 },
        "dimension": {
          "enum": [
            "semanticVisibility",
            "semanticCoherence",
            "semanticRichness",
            "semanticAuthority",
            "competitiveAdvantage"
          ]
        },
        "action": { "type": "string", "minLength": 8, "maxLength": 1000 },
        "expectedImpact": {
          "type": "string",
          "minLength": 4,
          "maxLength": 500
        },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    }
  }
}
