# GEO website application
# Copy this file to `.env.local` for `pnpm dev`; `.env.local` is Git-ignored.
# Production must set all secrets explicitly. The documented invite code may be
# changed without rebuilding the client because verification is server-side.
#
# Public build-time portal destination. In production configure this in the
# 1Panel build environment; do not create a production `.env` file.
VITE_CLIENT_PORTAL_URL=https://dashboard.frontmind.net/login

FRONTMIND_GEO_INVITE_CODE=
# Generate a unique random value of at least 32 characters before production.
FRONTMIND_GEO_SESSION_SECRET=
# Workflow gate supplied by the administrator after WeChat contract
# confirmation. The current business code is fixed server-side as frontmind666
# so production environment drift cannot make the administrator-provided code
# stop working.
# The retired FRONTMIND_GEO_CONTRACT_AUTH_CODE variable is intentionally ignored.

# FrontMind Agent's private presales broker.
FRONTMIND_PRESALES_AGENT_URL=http://frontmind-dashboard:3001/api/internal/presales/v2
# Generate a unique token and configure the exact same value in FrontMind Agent.
FRONTMIND_PRESALES_SERVICE_TOKEN=

# FrontMind Agent's private provisioning root. The website uses its account,
# purchase, knowledge-import, payment-receipt, and durable project-order
# endpoints. `/readyz` remains unavailable unless the project-order registry
# reports ready, so this URL and token are required before website startup.
# This service token must match Agent and must not reuse the presales token.
# Contract confirmation is relayed through the authenticated provisioning API;
# no Dashboard administrator credential belongs in the Website environment.
FRONTMIND_AGENT_PROVISIONING_URL=http://frontmind-dashboard:3001/api/internal/provisioning
FRONTMIND_PROVISIONING_SERVICE_TOKEN=
# Separate containers cannot reach each other through 127.0.0.1. Prefer an
# internal HTTPS endpoint. If a private Docker DNS name must use HTTP, list its
# exact hostname here (comma-separated, no schemes, ports, paths, or wildcards).
FRONTMIND_AGENT_INTERNAL_HTTP_HOSTS=frontmind-dashboard

# Optional administrator-notification relay for new manual signing orders.
# Configure both values or neither. Partial/unsafe configuration fails closed
# during GEO router initialization. The server POSTs signed generic JSON with
# X-FrontMind-Timestamp, X-FrontMind-Signature, and Idempotency-Key headers.
# The HTTPS receiver may relay it to an enterprise-WeChat bot or email
# automation. This is not the native enterprise-WeChat robot payload, so do
# not point it directly at a robot webhook URL.
# FRONTMIND_GEO_ADMIN_WEBHOOK_URL=https://notifications.example.com/frontmind/geo
# FRONTMIND_GEO_ADMIN_WEBHOOK_SECRET=

# ZPAY monitoring checkout. These values are server-only: never prefix them
# with VITE_ and never expose the merchant key to browser code.
FRONTMIND_ZPAY_PID=
FRONTMIND_ZPAY_KEY=
# Stable public HTTPS origin used to build notify_url and return_url.
# localhost cannot receive real ZPAY notifications.
FRONTMIND_PUBLIC_BASE_URL=https://www.frontmind.net
# Optional comma-separated ZPAY channel IDs. Leave empty for automatic routing.
# FRONTMIND_ZPAY_CID=1234

# Express trusted proxy CIDR/name or hop count. The secure default is
# "loopback"; set this to the exact production proxy topology when needed.
# FRONTMIND_TRUST_PROXY=loopback

# Optional local override. Production should pin the audited copied artifact:
# FRONTMIND_GEO_SKILLS_DIR=/app/dist/skills
# Leave this unset in local development to read server/skills.

# File-backed visitor statistics must live on a persistent private volume in
# production so a 1Panel container rebuild does not reset the counters. Start
# with a fresh file for this release: old stores classified requests without a
# trusted geography header as China. The server now reports them as Unknown.
# Forward a country header only from a trusted CDN/reverse proxy.
# FRONTMIND_VISITOR_STATS_FILE=/var/lib/frontmind-website/visitor-stats.json

# Required in production. Bind-mount this private directory from the host so an
# in-flight custom-question validation can resume with the same frozen file IDs,
# task ID and clientRequestId after a container restart. Do not place it in /tmp
# or in the image layer. The directory stores no API keys.
FRONTMIND_GEO_CUSTOM_QUESTION_STORE_DIR=/var/lib/frontmind-website/custom-question-validations

# Release identity is the signed OCI image digest. No dist approval SHA or
# runtime artifact-root environment variable is used by the application.
